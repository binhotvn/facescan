# Copy to .env and adjust. docker compose reads this file automatically.

# Event header shown in the app
FACESCAN_EVENT_NAME=Ảnh sự kiện Vĩnh Hưng
FACESCAN_EVENT_DATE=

# Required to enable POST /api/upload. Generate with: openssl rand -hex 24
# Leave empty and the upload endpoint stays disabled (503).
FACESCAN_UPLOAD_TOKEN=

# --- Worker nodes (see worker.py and docker-compose.worker.yml) ---
# Token worker nodes use to claim photos and send faces back. Keep it separate
# from the upload token. Empty: workers fall back to the upload token.
FACESCAN_WORKER_TOKEN=
# 0 = this server only serves; all face indexing is left to worker nodes.
FACESCAN_LOCAL_INDEXING=1
# Seconds a claimed photo stays reserved before another node may take it over.
FACESCAN_LEASE_SECONDS=300
# Web processes on this server (more = more simultaneous searches, ~1GB each)
WEB_CONCURRENCY=1

# Matching: higher = fewer, surer matches
FACESCAN_THRESHOLD=0.35

# Limits
FACESCAN_MAX_UPLOAD_MB=15       # selfie used as a search query
FACESCAN_MAX_PHOTO_MB=40        # event photo pushed to /api/upload
FACESCAN_MAX_UPLOAD_BATCH=50

# Detector input size: larger finds smaller faces in crowd shots, but is slower
FACESCAN_DET_SIZE=1024

# Face detection runs on a copy capped at this long edge (memory, not speed).
# 2560 detects the same faces as full resolution on 3840px photos.
FACESCAN_MAX_EDGE=2560
FACESCAN_QUERY_MAX_EDGE=1600
