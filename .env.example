# Copy to .env and adjust. docker compose reads this file automatically.

# Event header shown in the app
FACESCAN_EVENT_NAME=Ảnh sự kiện FF Agency
FACESCAN_EVENT_DATE=

# Required to enable POST /api/upload. Generate with: openssl rand -hex 24
# Leave empty and the upload endpoint stays disabled (503).
FACESCAN_UPLOAD_TOKEN=

# Matching: higher = fewer, surer matches
FACESCAN_THRESHOLD=0.35

# Limits
FACESCAN_MAX_UPLOAD_MB=15       # selfie used as a search query
FACESCAN_MAX_PHOTO_MB=40        # event photo pushed to /api/upload
FACESCAN_MAX_UPLOAD_BATCH=50

# Detector input size: larger finds smaller faces in crowd shots, but is slower
FACESCAN_DET_SIZE=1024
